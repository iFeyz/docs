{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Imoria",
  "description": "Documentation publique d'Imoria — un moteur d'analyse immobilière piloté depuis un client IA compatible MCP.",
  "colors": {
    "primary": "#e43416",
    "light": "#ff5336",
    "dark": "#e43416"
  },
  "background": {
    "color": {
      "light": "#fefcfa",
      "dark": "#0a0908"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "fr",
        "default": true,
        "pages": [
          {
            "group": " ",
            "pages": ["index"]
          },
          {
            "group": "Démarrer",
            "pages": [
              "demarrer/installation",
              {
                "group": "Installation par client",
                "pages": [
                  "demarrer/installation/claude-desktop",
                  "demarrer/installation/cursor",
                  "demarrer/installation/claude-code",
                  "demarrer/installation/autres-clients",
                  "demarrer/installation/http-sse"
                ]
              },
              "demarrer/premier-prompt"
            ]
          },
          {
            "group": "Chercher des biens",
            "pages": [
              "chercher/index",
              "chercher/recherche-criteres",
              "chercher/recherche-semantique",
              "chercher/annonces-sous-cotees",
              "chercher/inspecter-annonce"
            ]
          },
          {
            "group": "Évaluer & analyser",
            "pages": [
              "evaluer/index",
              "evaluer/estimer-valeur",
              "evaluer/comparables",
              "evaluer/etudier-quartier",
              "evaluer/comparer-marche"
            ]
          },
          {
            "group": "Outils géo",
            "pages": [
              "geo/index",
              "geo/geocoder",
              "geo/filtrer-poi"
            ]
          },
          {
            "group": "Ressources",
            "pages": [
              "ressources/index",
              "ressources/limites-et-couvertures",
              "ressources/faq",
              "ressources/glossaire",
              "ressources/reference-outils"
            ]
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 510
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Installer",
      "href": "/demarrer/installation"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp",
      "perplexity"
    ]
  },
  "seo": {
    "metatags": {
      "og:site_name": "Imoria — Documentation",
      "og:type": "website"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Chercher dans la documentation Imoria…"
  },
  "footer": {
    "socials": {}
  }
}
